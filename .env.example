# --- GHL API (for PATCHing Card_PDF_URL_EN/ES + Card_Status back onto the Contact) ---
GHL_API_KEY=
GHL_API_VERSION=2021-07-28

# Custom field IDs — copy these from GHL: Settings > Custom Fields.
# These are opaque IDs, not the field names. You must fill these in.
GHL_FIELD_ID_CARD_PDF_URL_EN=
GHL_FIELD_ID_CARD_PDF_URL_ES=
GHL_FIELD_ID_CARD_STATUS=

# The compositor looks up employees by email at this production URL:
#   POST https://<published-lovable-host>/api/internal/employee-lookup
#   Header: X-Internal-Secret: {CARD_COMPOSITOR_SHARED_SECRET}
#   Body: { "email": "maya@hotel.com" }
# That route lives in gratitude-attitude (not the public GET ?e= slug lookup).
GRATITUDE_APP_API_URL=
CARD_COMPOSITOR_SHARED_SECRET=

# --- Email provider (assumed Postmark per project notes — CONFIRM this is actually
# the provider in use before relying on it; swap src/email.js if it's something else) ---
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=info@gratitude-movement.com

# --- This service's own public URL, once deployed on Railway ---
# Used to build public links to the rendered PDFs (Card_PDF_URL_EN/ES) and to serve
# them from /files. Set this to the Railway-assigned domain after first deploy.
PUBLIC_BASE_URL=

# --- Shared secret to verify the incoming GHL webhook (recommended) ---
# If set, incoming requests must include this in an X-Webhook-Secret header.
# Configure the same value in the GHL workflow's webhook action headers.
WEBHOOK_SHARED_SECRET=

PORT=3000
